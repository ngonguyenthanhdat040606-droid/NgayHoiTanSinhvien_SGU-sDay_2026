rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if caller has signed in (anonymous or authenticated)
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function: check if caller is an admin / organizer
    function isOrganizer() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.matches('.*@(sgu|student[.]sgu)[.]edu[.]vn$')) ||
        request.auth.token.admin == true
      );
    }

    // Students collection: Secure registration and check-in updates
    match /students/{studentId} {
      // 1. Allow reading for connected users
      allow read: if isSignedIn();

      // 2. Allow creating a student record with schema validation
      allow create: if isSignedIn()
        && request.resource.data.mssv is string
        && request.resource.data.mssv.size() >= 6
        && request.resource.data.fullName is string
        && request.resource.data.completedStations is list;

      // 3. Allow updating completed stations and profile without changing the core MSSV
      allow update: if isSignedIn()
        && (!('mssv' in resource.data) || request.resource.data.mssv == resource.data.mssv)
        && request.resource.data.completedStations is list
        && request.resource.data.completedStations.size() <= 12
        && (!('completedBooths' in request.resource.data) || request.resource.data.completedBooths is list);

      // 4. Disallow client-side deletion to prevent malicious data wipe
      allow delete: if isOrganizer();
    }

    // Station checkin ledger: Append-Only (Immutable Logs)
    match /station_checkins/{checkinId} {
      // Allow read for event reporting
      allow read: if isSignedIn();

      // Allow appending new checkin records with valid stationId
      allow create: if isSignedIn()
        && request.resource.data.stationId in [
          'station-1', 'station-2', 'station-3', 'station-4',
          'station-5', 'station-6', 'station-7', 'station-8', 'station-9',
          'station-10', 'station-11', 'station-12',
          'booth-agribank', 'booth-vietcombank', 'booth-oppo', 'booth-viettel', 'booth-im', 'booth-weset'
        ]
        && request.resource.data.timestamp is string;

      // Immutable: Never allow editing or deleting historical check-in logs
      allow update, delete: if false;
    }

    // System logs: Append-Only
    match /system_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}

